# Copy this file to .env.local and fill in real values there.
# .env.local is already gitignored (see .gitignore) — never commit real secrets.

# Which LLM /api/copilotkit uses: "anthropic" (default) or "openai". Only the
# matching key below needs to be set. "deepseek" is ALSO accepted by the eval
# harness (npm run eval:assistant) as a cost-comparison candidate, but is NOT
# yet wired into route.ts/production — see DEEPSEEK_API_KEY below.
LLM_PROVIDER=anthropic

# Server-side only. Used when LLM_PROVIDER=anthropic (the default). Get one
# at https://console.anthropic.com/ — never prefix this with NEXT_PUBLIC_,
# that would ship it to the browser. Paid (pay-as-you-go). Zero compatibility
# bugs found with @copilotkit/runtime — see route.ts's comment.
ANTHROPIC_API_KEY=

# Server-side only. Used when LLM_PROVIDER=openai. Get one at
# https://platform.openai.com/api-keys — never prefix with NEXT_PUBLIC_.
# Paid (pay-as-you-go), also zero compatibility bugs found despite sharing
# code shape with GroqAdapter below — see route.ts's comment for why.
OPENAI_API_KEY=

# Server-side only. Used when LLM_PROVIDER=deepseek (eval harness only, see
# above). Get one at https://platform.deepseek.com/api_keys. Paid
# (pay-as-you-go, ~4-10x cheaper than OpenAI/Anthropic per token). Confirmed
# OpenAI-Chat-Completions-compatible with reliable tool-calling on the
# current deepseek-v4-flash model — see runner.ts's comment. Not yet plumbed
# into route.ts/production; validate via `npm run eval:assistant` first.
DEEPSEEK_API_KEY=

# Free-tier key at https://console.groq.com/keys. Not currently usable here:
# every adapter path this package offers for Groq hits either a protocol bug
# (tool-result handling) or an internal feature that demands a real
# openai/anthropic/google key regardless — see route.ts.
GROQ_API_KEY=

# Free-tier key at https://aistudio.google.com/apikey. Not currently usable
# here: GoogleGenerativeAIAdapter's tool-result event drops the tool's
# return content, so any turn after a tool call errors — see route.ts.
GOOGLE_API_KEY=

# Server-side only. Signs the session cookie in src/lib/session — any long
# random string works, e.g. generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Optional. Pins "today" for src/lib/data/clock.ts (e.g. "2026-07-25").
# Leave unset to use the real current date.
NEXT_PUBLIC_DEMO_TODAY=
